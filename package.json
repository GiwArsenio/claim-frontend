{
  "name": "claim-frontend",
  "version": "1.0.0",
  "description": "CLAIM! — Job board actuariat & IA en assurance",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "serve": "python3 -m http.server 8099",
    "test": "node --test tests/",
    "test:theme": "node --test tests/theme.test.cjs",
    "captures": "node tools/captures.cjs captures",
    "audit:theme": "node tools/audit-theme.cjs",
    "dev": "wrangler dev",
    "deploy": "bash scripts/prepare-assets.sh && wrangler deploy",
    "assets": "bash scripts/prepare-assets.sh",
    "test:workers": "node tests-portage/verifier-rendu.js",
    "test:workers:complet": "node tests-portage/verifier-rendu.js --complet",
    "aligner:rendu": "python3 scripts/aligner-rendu.py",
    "aligner:rendu:verifier": "python3 scripts/aligner-rendu.py --verifier",
    "deploy:check": "bash scripts/prepare-assets.sh && wrangler deploy --dry-run"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GiwArsenio/claim-frontend.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/GiwArsenio/claim-frontend/issues"
  },
  "homepage": "https://github.com/GiwArsenio/claim-frontend#readme",
  "devDependencies": {
    "axe-core": "^4.14.0",
    "pixelmatch": "^5.3.0",
    "playwright": "^1.64.1",
    "pngjs": "^7.0.0",
    "wrangler": "^4.152.0"
  }
}
