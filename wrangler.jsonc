{
  // CLAIM! — Cloudflare Workers (Static Assets + SSR)
  //
  // Le site est du HTML/CSS/JS vanilla, sans build : les fichiers de
  // `public/` sont servis tels quels. Les trois adresses dynamiques
  // (/offre/{slug}, /sitemap.xml, /robots.txt) sont rendues par le Worker.
  //
  // ── Pourquoi `assets_navigation_has_no_effect` ───────────────────────
  // Depuis le 1er avril 2025, une requete portee par `Sec-Fetch-Mode:
  // navigate` — ce qu un navigateur envoie quand on suit un lien ou qu on
  // tape une adresse — court-circuite le Worker et va directement a la
  // logique d assets.
  //
  // Consequence sur CLAIM! : la racine et /sitemap.xml repondent 404 au
  // navigateur, alors qu elles repondent 200 a un robot. C etait invisible
  // pendant les tests — curl et les robots n envoient pas cet en-tete — et
  // c etait le premier symptome du site qui ne s ouvrait pas le 25 octobre.
  //
  // Ce drapeau rend le court-circuit sans effet : les requetes de
  // navigation atteignent le Worker comme les autres.
  //
  // L alternative aurait ete `run_worker_first: true`, qui fait traverser
  // TOUTE requete au Worker — y compris le trafic SEO des fichiers
  // statiques, gratuit et illimite sur le CDN. Ce serait du quota
  // d invocations gaspille. Le drapeau est donc la solution meilleur : il
  // corrige la navigation sans toucher au routage du reste.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "claim-frontend",
  "compatibility_date": "2026-10-24",
  "compatibility_flags": ["nodejs_compat", "assets_navigation_has_no_effect"],
  "main": "src/index.js",

  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // Une page 404 explicite : le gabarit du site, pas la page par défaut
    // de la plateforme. `none` laisserait un trou nu sur les adresses
    // inexistantes.
    "not_found_handling": "404-page",

    // ── Point critique du portage ──────────────────────────────────────
    // Par défaut, Workers Static Assets redirige (307) toute adresse
    // `.html` vers sa version sans extension : /job-board.html devient
    // /job-board. Sur CLAIM!, c'est un piège : le board, l'accueil, les
    // pages Entreprises et Observatoire sont des adresses `.html` connues,
    // indexées par Google et partagées. Les faire basculer en 307
    // casserait les liens existants et affaiblirait le signal SEO.
    //
    // `none` sert l'adresse exacte, sans redirection ni réécriture.
    // Le site garde ainsi ses adresses, et le board reste coherent avec
    // les liens publishes sur la page Entreprises et dans les emails.
    "html_handling": "none"
  },

  // Le domaine custom : la racine du site est attachee au Worker, qui
  // decide ce qui est rendu et ce qui est servi depuis le CDN.
  "routes": [
    { "pattern": "claimyourjob.fr", "custom_domain": true },
    { "pattern": "www.claimyourjob.fr", "custom_domain": true }
  ],

  "vars": {
    "API_URL": "https://claim-api-production-06b3.up.railway.app/api/v1",
    "SITE_URL": "https://claimyourjob.fr"
  },

  // Observabilité : les erreurs de rendu doivent se voir, comme sur Vercel.
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
