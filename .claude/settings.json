{
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)"
    ],
    "ask": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git reset --hard *)",
      "Bash(gh api -X DELETE *)",
      "Bash(gh repo delete *)",
      "mcp__Supabase__apply_migration",
      "mcp__Supabase__deploy_edge_function",
      "mcp__Supabase__delete_branch",
      "mcp__Supabase__reset_branch",
      "mcp__Supabase__merge_branch",
      "mcp__Supabase__pause_project",
      "mcp__Railway__delete-service",
      "mcp__Railway__delete-volume",
      "mcp__Railway__delete-bucket",
      "mcp__Railway__accept-deploy",
      "mcp__Railway__set-variables",
      "mcp__Railway__update-service",
      "mcp__Railway__redeploy",
      "mcp__Railway__restart-service",
      "mcp__Cloudflare_Developer_Platform__d1_database_delete",
      "mcp__Cloudflare_Developer_Platform__kv_namespace_delete",
      "mcp__Cloudflare_Developer_Platform__r2_bucket_delete",
      "mcp__Cloudflare_Developer_Platform__hyperdrive_config_delete"
    ]
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/rappel_regles.py",
            "args": [],
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/verifier_affirmations.py",
            "args": [],
            "timeout": 20
          }
        ]
      }
    ]
  }
}
